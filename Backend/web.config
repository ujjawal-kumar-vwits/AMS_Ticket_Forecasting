<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <system.webServer>

    <!-- URL Rewrite -->
    <rewrite>
      <rules>
        <rule name="ReverseProxyInboundRule" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Add HttpOnly to proxied cookies" preCondition="CookieMissingHttpOnly">
          <match serverVariable="RESPONSE_Set_Cookie" pattern=".*" />
          <action type="Rewrite" value="{R:0}; HttpOnly" />
        </rule>
        <preConditions>
          <preCondition name="CookieMissingHttpOnly">
            <add input="{RESPONSE_Set_Cookie}" pattern=";\s*HttpOnly" negate="true" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <!-- Optional: Increase upload size -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />

  </system.webServer>

  <system.web>
    <httpCookies httpOnlyCookies="true" />
  </system.web>

</configuration>